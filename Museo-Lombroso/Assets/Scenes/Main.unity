  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Cesare Lombroso began collecting anatomical and criminal anthropology
    specimens in 1859. The collection moved several times\u2014Via della Zecca, Via
    Po, Via Michelangelo, and Corso Galileo Galilei\u2014before being partially displayed
    in the 1985 exhibition La scienza e la colpa. In 2001, it found a permanent home
    at Via Giuria 15, within the Palazzo degli Istituti Anatomici, alongside the
    Museums of Human Anatomy, Anthropology & Ethnography, and, since 2006, the Museum
    of Fruit, forming a center dedicated to Turin\u2019s scientific positivism of
    the 19th and early 20th centuries."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: fc90b3d5142b67645b75144c914cb84d, type: 2}
  m_sharedMaterial: {fileID: 125123631794993483, guid: fc90b3d5142b67645b75144c914cb84d, type: 2}
