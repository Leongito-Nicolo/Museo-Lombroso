  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "The theories developed by Cesare Lombroso are today widely recognized
    as forms of pseudoscience grounded in 19th-century assumptions about biology,
    race, class, and social \u201Cdeviance.\u201D His work often reinforced racist,
    classist, and ableist stereotypes, and contributed to discriminatory practices
    that targeted marginalized communities. The Lombroso Museum does not endorse
    these ideas. Instead, it presents them within their historical context to encourage
    critical reflection on how scientific authority can be misused and how such narratives
    have shaped social policy, criminal justice, and public perceptions of difference.
    Visitors are invited to approach the collections with awareness of these ethical
    and historical issues and to engage thoughtfully with the complex legacy of Lombroso\u2019s
    work."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: fc90b3d5142b67645b75144c914cb84d, type: 2}
  m_sharedMaterial: {fileID: 125123631794993483, guid: fc90b3d5142b67645b75144c914cb84d, type: 2}
