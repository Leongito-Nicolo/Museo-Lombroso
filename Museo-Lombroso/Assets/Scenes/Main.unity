  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>Da Sherlock Holmes alle impronte digitali</b>\nLaboratorio pratico
    di 90 minuti dedicato a metodi investigativi, sperimentazione e basi dell\u2019osservazione
    forense.\nCosto: \u20AC75 a classe (max 25 studenti)\n\nL\u2019ingresso al museo
    \xE8 gratuito per tutte le classi scolastiche.\nPrenotazione obbligatoria per
    visite e laboratori:\nTel. 011 6707732 (lun\u2013ven, 9:00\u201313:00 / 14:00\u201315:00)\nEmail:
    <i>didattica.musei@unito.it</i>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: fc90b3d5142b67645b75144c914cb84d, type: 2}
