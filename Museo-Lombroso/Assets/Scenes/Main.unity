  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: Children under 10; students and staff of the University of Turin; ICOM
    members; directors and curators of Italian and foreign museums; school classes
    from public institutions of all levels with advance booking; visitors with disabilities
    and their companions; officially licensed tour guides; personnel of the Italian
    Ministry of Culture in managerial roles; registered journalists; and current
    municipal, district, and regional administrators of Turin and Piedmont, as well
    as staff of the Experimental Institute for Plant Nutrition.
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: fc90b3d5142b67645b75144c914cb84d, type: 2}
